menu "AirGradient HTTP Server"

    config AG_HTTP_PORT
        int "Default HTTP listen port"
        range 1 65535
        default 80
        help
            Default port the HTTP server listens on. Products may override
            this at runtime by passing a different value to start().

    config AG_HTTP_MAX_CONNECTIONS
        int "Maximum concurrent connections"
        range 1 16
        default 4
        help
            Maximum number of simultaneous TCP connections the server will
            accept. Passed to esp_http_server as max_open_sockets.

    config AG_HTTP_MAX_BODY_SIZE
        int "Maximum request body size (bytes)"
        range 256 65536
        default 4096
        help
            Upper bound for buffered request bodies. Requests with bodies
            larger than this cap will be truncated to this size before the
            handler runs.

    config AG_HTTP_MAX_ROUTES
        int "Maximum number of registered routes"
        range 4 64
        default 24
        help
            Maximum number of URI handlers the server will accept. Passed
            to esp_http_server as max_uri_handlers. The provisioning
            captive portal registers ~16 routes (API + OS probe URLs),
            so the default must accommodate that with headroom.

endmenu
