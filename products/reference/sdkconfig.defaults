# Thin reference product defaults.
# Add product-specific sdkconfig settings here as the first real product takes shape.

# ESP32-C5: the GPIO light-sleep reset workaround calls gpio_sleep_sel_en()
# for every GPIO via REGDMA, which stalls indefinitely on this chip during
# early startup before the scheduler is running.  Disable it until the
# underlying IDF issue is resolved.
CONFIG_ESP_SLEEP_GPIO_RESET_WORKAROUND=n

# Reference firmware compiles every RUN_TEST_* source even though only one
# is dispatched in app_main; with the airgradient-provisioning component
# added (HTTP routes + captive DNS + flash-embedded portal.html), the
# default 1 MB single-app partition overflows. Switch to the stock
# "single app, large" preset (~1.5 MB factory partition) for headroom.
CONFIG_PARTITION_TABLE_SINGLE_APP=n
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# BLE: NimBLE peripheral-only, single connection, bond persistence.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_SM_LEGACY=y
CONFIG_BT_NIMBLE_SM_SC=y
